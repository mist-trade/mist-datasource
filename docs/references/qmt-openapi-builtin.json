      "CommandRequest": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "health",
              "runtime_introspection",
              "get_market_data_ex",
              "get_stock_list_in_sector"
            ],
            "title": "Method",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "timeoutSeconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeoutseconds"
          }
        },
        "required": [
          "method"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ObservabilityRequest": {
        "additionalProperties": false,
        "description": "Bridge-side counters for E-0 throughput observation (no OTel in terminal).\n\nBridge sends ownerId/leaseToken/generation alongside intervalSeconds;\nmodel accepts them as optional aliases to avoid 422 when extra=forbid.\nNo loopback ownership check is done here (same as before).",
        "properties": {
          "counters": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Counters",
            "type": "object"
          },
          "generation": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation"
          },
          "intervalSeconds": {
            "default": 30.0,
            "title": "Intervalseconds",
            "type": "number"
          },
          "leaseToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leasetoken"
          },
          "ownerId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ownerid"
          },
          "sender": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender"
          }
        },
        "required": [
          "counters"
        ],
        "title": "ObservabilityRequest",
        "type": "object"
      },
      "OwnerRequest": {
        "additionalProperties": false,
        "properties": {
          "bridgeArtifactSha256": {
            "title": "Bridgeartifactsha256",
