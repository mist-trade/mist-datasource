    "/qmt/bridge/observability": {
      "post": {
        "description": "Accept bridge-side counters (E-0) and surface them as a log line.\n\nLoopback-only; the counters carry no sensitive data, so owner validation\nis intentionally omitted (unlike TDX, the QMT controller exposes no public\nidentity check for auxiliary endpoints).",
        "operationId": "post_observability_qmt_bridge_observability_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObservabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Post Observability Qmt Bridge Observability Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Observability",
        "tags": [
          "QMT Bridge"
        ]
      }
    },
