        "type": "object"
      },
      "QmtDownloadJobRequest": {
        "additionalProperties": false,
        "description": "Submit a history download job (QMT terminal local cache refresh).\n\n``base_periods`` must be a subset of the stored base periods {1m,5m,1d}\n(other periods are synthesized from them). The job runs serially in the\nbridge; poll ``GET /v1/qmt/download/{job_id}`` for completion.",
        "properties": {
          "base_periods": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Base Periods",
            "type": "array"
          },
          "end_time": {
            "pattern": "^\\d{8}(\\d{6})?$",
            "title": "End Time",
            "type": "string"
          },
          "start_time": {
            "pattern": "^\\d{8}(\\d{6})?$",
            "title": "Start Time",
            "type": "string"
          },
          "stock_list": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Stock List",
            "type": "array"
          }
        },
        "required": [
          "stock_list",
          "base_periods",
          "start_time",
          "end_time"
        ],
        "title": "QmtDownloadJobRequest",
        "type": "object"
      },
